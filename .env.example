# Copia este archivo como .env y ajusta los valores.
DATABASE_URL=postgresql://sudoker:sudoker@localhost:5432/sudoker

# placeholder = generador temporal (dificultad hardcodeada, sin Solver ni DifficultyGrader)
# real        = Generator del engine (cuando Solver y DifficultyGrader estén listos)
PUZZLE_ENGINE=placeholder
